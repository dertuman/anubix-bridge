# ─── Local bridge (minimal setup) ──────────────────────────────
# Generated for you by anubix-web when you click "Connect my computer".
# Just paste the two values below; everything else is sensible defaults.
ANUBIX_INSTALL_TOKEN=
BRIDGE_API_KEY=

# ─── Overrides (optional) ──────────────────────────────────────
# Point at a self-hosted anubix-web. Defaults to https://anubix.ai.
# ANUBIX_WEB_URL=
# Skip the Cloudflare Quick Tunnel and use your own public URL.
# TUNNEL_MODE=manual
# PUBLIC_URL=https://your-bridge.example.com
# Use the Claude API instead of your Claude Code CLI subscription.
# CLAUDE_MODE=sdk
# ANTHROPIC_API_KEY=

# ─── Local dev only ────────────────────────────────────────────
# Base path to expose your repos under short names.
# REPOS_BASE_PATH=
